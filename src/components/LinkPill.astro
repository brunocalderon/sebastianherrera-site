---
import type { ProfileLink } from "../data/links";

interface Props {
  link: ProfileLink;
}

const { link } = Astro.props;
---

<a
  href={link.href}
  target="_blank"
  rel="noopener noreferrer"
  class="link-pill-shadow grid h-16 w-full max-w-[524px] grid-cols-[48px_1fr_48px] items-center gap-0 rounded-2xl bg-white px-3 transition-transform hover:scale-[1.01] active:scale-[0.99] sm:mx-auto max-sm:max-w-[calc(100%-28px)] max-sm:mx-auto"
>
  <span class="flex size-12 items-center justify-center overflow-hidden rounded-full bg-[#f4f4f4]">
    <img
      src={link.thumbnail}
      alt=""
      width={48}
      height={48}
      class="size-full object-cover"
      loading="lazy"
    />
  </span>
  <span class="truncate px-2 text-center text-base font-normal leading-4 text-black">
    {link.title}
  </span>
  <span class="flex size-8 items-center justify-center justify-self-end text-black/70" aria-hidden="true">
    <svg width="4" height="16" viewBox="0 0 4 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <circle cx="2" cy="2" r="2" />
      <circle cx="2" cy="8" r="2" />
      <circle cx="2" cy="14" r="2" />
    </svg>
  </span>
</a>
