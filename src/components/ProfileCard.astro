---
import { profile } from "../data/profile";
import LinkPill from "./LinkPill.astro";
import { renderInlineMarkdown } from "../utils/markdown";
---

<main class="mx-auto flex min-h-dvh w-full max-w-[580px] flex-col px-0 pt-0 sm:pt-10">
  <article
    class="profile-card-shadow flex w-full flex-1 flex-col overflow-hidden rounded-t-3xl bg-page min-h-[calc(100dvh)] sm:min-h-[calc(100dvh-2.5rem)]"
  >
    <div class="hero-fade relative z-0 aspect-square w-full overflow-hidden rounded-t-3xl bg-page">
      <img
        src={profile.heroImage}
        alt={profile.heroAlt}
        width={580}
        height={580}
        class="absolute inset-0 z-[1] size-full object-cover"
        fetchpriority="high"
      />
    </div>

    <div class="relative z-10 -mt-6 flex w-full flex-1 flex-col items-center px-7 pb-8">
      <h1 class="font-heading text-[40px] font-semibold leading-[48px] text-primary">
        {profile.name}
      </h1>
      <h2 class="bio-markdown mt-1 text-center text-base font-normal leading-6 text-primary">
        {
          profile.bio.map((line, index) => (
            <>
              {index > 0 && <br />}
              <span set:html={renderInlineMarkdown(line)} />
            </>
          ))
        }
      </h2>

      <div class="mt-4 flex justify-center gap-3">
        {
          profile.socials.map((social) =>
            social.type === "INSTAGRAM" ? (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary transition-opacity hover:opacity-70"
                aria-label={`${profile.name} Instagram`}
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
                </svg>
              </a>
            ) : null,
          )
        }
      </div>

      <div class="mt-6 flex w-full flex-col gap-3.5">
        {profile.links.map((link) => (
          <LinkPill link={link} />
        ))}
      </div>
    </div>
  </article>
</main>
