---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Sebastian Herrera" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sebastian Herrera — Hyrox Level 2 Certified Coach, Co-Founder NAW Training Lab" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-page font-body text-primary antialiased">
    <slot />
  </body>
</html>
