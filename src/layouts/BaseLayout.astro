---
import "../styles/global.css";
import { profile } from "../data/profile";
import { bioToPlainText } from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const pageTitle = Astro.props.title ?? `${profile.name} | Hyrox & Strength Coach`;
const description =
  Astro.props.description ?? bioToPlainText(profile.bio);
const imagePath = Astro.props.image ?? profile.heroImage;
const imageAlt = Astro.props.imageAlt ?? profile.heroAlt;

const canonicalPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const shortTitle = profile.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#89959f" />
    <link rel="canonical" href={canonicalPath} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={shortTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalPath} />
    <meta property="og:image" content={imagePath} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagePath} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body class="min-h-dvh bg-page font-body text-primary antialiased">
    <slot />
  </body>
</html>
